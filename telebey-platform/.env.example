# ─── Telebey Auth Stack — Environment Variables ───────────────────────────────
# Usage: cp .env.example .env
# Then fill in real secrets before running docker compose up

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
BCRYPT_ROUNDS=12

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://telebey:password@postgres:5432/telebey_db
POSTGRES_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change_this_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── AES-256 Encryption (must be exactly 32 characters) ───────────────────────
ENCRYPTION_KEY=change_this_to_a_32_char_key_!!
