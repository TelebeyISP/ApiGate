# ─────────────────────────────────────────────────────────────────────────────
# Telebey Auth Stack — Environment Variables
# Copy to .env:  cp .env.example .env
# Generate JWT secrets:  openssl rand -base64 64
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# PaaS/Heroku connection string (takes priority when set)
DATABASE_URL=postgresql://telebey:password@postgres:5432/telebey_db

# Individual connection vars (used by TypeORM when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_USER=telebey
DB_PASSWORD=password
DB_NAME=telebey_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_secret_here
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── AES-256 Encryption ────────────────────────────────────────────────────────
# Must be exactly 32 characters
ENCRYPTION_KEY=your_32_char_encryption_key_here!
