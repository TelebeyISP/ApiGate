# General
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=telebey_user
DB_USER=telebey_user
DB_PASSWORD=telebey_pass
DB_NAME=telebey_db

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me

# Open5GS / isp.router-dashboard
# Shared subscriber store used by Open5GS WebUI and the 5G core
OPEN5GS_MONGODB_URI=mongodb://localhost:27017/open5gs
OPEN5GS_WEBUI_URL=http://localhost:9999

# GSMA Open Gateway Configuration
GSMA_GATEWAY_BASE_URL=https://api.telebey.com/gsma
GSMA_CLIENT_ID=your_gsma_client_id
GSMA_CLIENT_SECRET=your_gsma_client_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
