# General
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=telebey_user
DB_PASSWORD=telebey_pass
DB_NAME=telebey_db

# Cache (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_ACCESS_SECRET=your_ultra_secure_access_token_secret
JWT_REFRESH_SECRET=your_ultra_secure_refresh_token_secret

# Open5GS Configuration
OPEN5GS_MONGODB_URI=mongodb://mongo:27017/nextgepc

# GSMA Open Gateway Configuration
GSMA_GATEWAY_BASE_URL=https://api.telebey.com/gsma
GSMA_CLIENT_ID=your_gsma_client_id
GSMA_CLIENT_SECRET=your_gsma_client_secret

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
